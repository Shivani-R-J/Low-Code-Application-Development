		workflow
		{
		form
		{
			Send_Email_Form_Propertie as "Send Email - Form Properties"
			{
				type =  presuccess
				form = Service_Request_Form
				on start
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : Email_Address
							subject : "Vehicle Service : New entry added"
							message : "<div>Hello,<br><br>A new entry added in 'Service_Request_Form' form of Vehicle Service application.<br></div>"
						)
					}
				}
			}
			On_ServiceRequest_Submit_ as "On ServiceRequest Submit Workflow"
			{
				type =  form
				form = Service_Request_Form

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											sendmail
										[
											from :zoho.adminuserid
											to :input.Email_Address
											subject :"Service Request Confirmation - " + input.Vehicle_Registration_Number
											message :"Thank you for submitting your service request. We have successfully registered your vehicle for service."
										]
						)
					}
				}

			}
			HighCost_Repair_Approval as "HighCost Repair Approval"
			{
				type =  form
				form = Service_Request_Form

				record event = on edit

				on update of Estimated_Service_Cost
				{
					actions 
					{
						custom deluge script
						(
											sendmail
										[
											from :zoho.adminuserid
											to :input.Email_Address
											subject :"Approval Required: Repair Estimate for Vehicle " + input.Vehicle_Registration_Number
											message :"Dear Customer,<br><br>Our technicians have inspected your vehicle <b>(" + input.Vehicle_Registration_Number + ")</b> and prepared an updated service estimate.<br><br><b><u>Estimate Details</u></b><br>• <b>Service Request ID:</b> " + input.ID + "<br>• <b>Estimated Cost:</b> ₹" + input.Estimated_Service_Cost + "<br>• <b>Issue Description:</b> " + input.Issue_Description + "<br><br>Because the estimate exceeds our standard threshold, we require your explicit approval before our technicians proceed with the repair work.<br><br>Please review and confirm your approval via your customer portal or respond to this notification to authorize the repairs.<br><br>Best regards,<br><b>Vehicle Service Command Center</b>"
										]
						)
					}
				}

			}
			Service_Payment_Workflow as "Service Payment Workflow"
			{
				type =  form
				form = Service_Request_Form

				record event = on edit

				on update of Status
				{
					actions 
					{
						custom deluge script
						(
											sendmail
										[
											from :zoho.adminuserid
											to :input.Email_Address
											subject :"Your Vehicle is Ready for Pickup - Payment Request for " + input.Vehicle_Registration_Number
											message :"Dear Customer,<br><br>Great news! The service for your vehicle <b>(" + input.Vehicle_Registration_Number + ")</b> has been completed and it is ready for pickup.<br><br><b><u>Payment Summary</u></b><br>• <b>Service Request ID:</b> " + input.ID + "<br>• <b>Total Payable Amount:</b> ₹" + input.Net_Service_Cost_Payable + "<br><br>Please complete your payment online using the payment link generated in your portal prior to collecting your vehicle. Once payment is confirmed, your vehicle release pass will be issued automatically.<br><br>Thank you for choosing our service center!<br><br>Best regards,<br><b>Vehicle Service Command Center</b>"
										]
						)
					}
				}

			}
		}

