		batchworkflow
		{
			Bulk_ServiceDue_Reminder_
			{
    			display name = "Bulk ServiceDue Reminder Batch"
    			type = batchworkflow
    			form = Service_Request_Form
    			event = "On Schedule"
    			start = "10-Nov-2026 15:00:00"
    			frequency = monthly
    			batch size = 200
    			status = active
    			on execute 
    			{
					actions 
					{
						custom deluge script
						(
											sendmail
										[
											from :zoho.adminuserid
											to :input.Email_Address
											subject :"Time for Your Vehicle's Periodic Service - " + input.Vehicle_Registration_Number
											message :"Dear Customer,<br><br>Our records indicate that your vehicle <b>(" + input.Vehicle_Registration_Number + ")</b> is due for its next periodic service maintenance.<br><br>Regular maintenance ensures optimal performance, safety, and longevity for your vehicle.<br><br><b><u>Service Booking Details</u></b><br>• <b>Vehicle Registration Number:</b> " + input.Vehicle_Registration_Number + "<br>• <b>Recommended Action:</b> Book a Routine Service appointment<br><br>Please submit a new service request online or contact our service desk to schedule your drop-off at your preferred time.<br><br>Best regards,<br><b>Vehicle Service Command Center</b>"
										]
						)
					}
    			}
			}
		}

