 application "Vehicle Service"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Service_Request_Form
		{
			success message = "Data Added Successfully!"
			Owner_Details
			(
				type = section
				displayname = "Owner Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Owner_Name1
			(
    			type = name
				displayname = "Owner Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Vehicle_Registration_Number
			(
    			type = text
				displayname = "Vehicle Registration Number"
				maxchar = 20
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Vehicle_Type
			(
				type = picklist
				displayname = "Vehicle Type"
				maxchar = 100
				values = {"Sedan","SUV","Hatchback","Convertible"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Contact_Details
			(
				type = section
				displayname = "Contact Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Email_Address
			(
    			type = email
				displayname = "Email Address"
				maxchar = 50
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Contact_Number
			(
    			type = phonenumber
				displayname = "Contact Number"
    			defaultcountry="in"
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Pickup_Address
			(
    			type = address
				displayname = "Pickup Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Vehicle_Issue_Details
			(
				type = section
				displayname = "Vehicle & Issue Details"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			must have Odometer_Reading
			(
				type = number
				displayname = "Odometer Reading"
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Service_Type
			(
				type = radiobuttons
				displayname = "Service Type"
				maxchar = 100
				values = {"Routine Service","Breakdown Repair","Accident Repair"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Additional_Services_Requested
			(
				type = list	
				values = {"Car Wash","Interior Cleaning","Tyre Rotation"}
				height = 60px
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Issue_Description
			(
    			type = textarea
				displayname = "Issue Description"
				height = 100px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Scheduling_Authorization
			(
				type = section
				displayname = "Scheduling & Authorization"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			must have Preferred_Service_Date
			(
    			type = date
				displayname = "Preferred Service Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 4
	 			column = 1   
				width = medium
			)
			must have Preferred_Dropoff_Time
			(
    			type = time
				displayname = "Preferred Dropoff Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 4
	 			column = 1   
				width = medium
			)
			must have Authorize_Estimate_And_Repair
			(
				type = checkboxes	
				displayname = "Authorize Estimate And Repair"
				values = {"Checked"}
	 			row = 4
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Requested","In Repair","Ready for PickUp","Delivered"}
	 			row = 4
	 			column = 1   
				width = medium
			)
			Vehicle_Verification_Evidence
			(
				type = section
				displayname = "Vehicle Verification & Evidence"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			Vehicle_Models
			(
				type = picklist	
				displayname = "Vehicle Models"
				values  = Vehicle_Models.ID
    			displayformat = [Vehicle_Model]
				sortorder = ascending
	 			row = 5
	 			column = 1   
				width = medium
			)
			Vehicle_Damage_Photo
			(
    			type = image
				displayname = "Vehicle Damage Photo"
				source  = file
    			file count = 10
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 5
	 			column = 1   
				width = medium
			)
			Insurance_Copy_Upload
			(
    			type = upload file
				displayname = "Insurance Copy Upload"
    			file count = 10
				browse = local_drive
	 			row = 5
	 			column = 1   
				width = medium
			)
			must have Vehicle_Age_Years
			(
				type = decimal
				displayname = "Vehicle Age  Years"
				maxchar = 7
	 			row = 5
	 			column = 1   
				width = medium
			)
			Previous_Service_History
			(
				type = grid
				displayname = "Previous Service History"
				Previous_Service_Date
				(
    				type = date
					displayname = "Previous Service Date"
					alloweddays = 0,1,2,3,4,5,6
					width = medium
				)
				Service_Type
				(
					type = picklist
					displayname = "Service Type"
					maxchar = 100
					values = {"Oil Change","Brake Pad Replacement","Engine Service","Wheel Alignment","General Service"}
					width = medium
				)
				Cost_Incurred
				(
					displayname = "Cost Incurred"
					type = INR
					format = commadotindian
					width = medium
				)
	 			row = 6
	 			column = 1   
				width = medium
			)
			Service_History_Media_Details
			(
				type = section
				displayname = "Service History & Media Details"
				visibility = true
	 			row = 7
	 			column = 0   
				width = medium
			)
			Insurance_Policy_Portal_URL
			(
    			type = url
				displayname = "Insurance Policy Portal URL"
				enable  linkname
	 			row = 7
	 			column = 1   
				width = medium
			)
			Vehicle_Issue_Video
			(
    			type = video
				displayname = "Vehicle Issue Video"
    			duration=30
	 			row = 7
	 			column = 1   
				width = medium
			)
			Engine_Sound_Voice_Note
			(
     			type = audio
				displayname = "Engine Sound Voice Note"
    			duration=60
	 			row = 7
	 			column = 1   
				width = medium
			)
			Cost_Pickup_Preference
			(
				type = section
				displayname = "Cost & Pickup Preference"
				visibility = true
	 			row = 8
	 			column = 0   
				width = medium
			)
			must have Requires_Pickup_Drop_Service
			(
    			type = checkbox
				displayname = "Requires Pickup Drop Service"
				initial value = false
	 			row = 8
	 			column = 1   
				width = medium
			)
			Estimated_Service_Cost
			(
				displayname = "Estimated Service Cost"
				type = INR
				decimalplace = 0
				maxchar = 9
	 			row = 8
	 			column = 1   
				width = medium
			)
			Service_Discount_Percent
			(
    			type = percentage
				displayname = "Service Discount Percent"
	 			row = 8
	 			column = 1   
				width = medium
			)
			Net_Service_Cost_Payable
			(
				type = decimal
				displayname = "Net Service Cost Payable"
	 			row = 8
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  input.Estimated_Service_Cost - input.Estimated_Service_Cost * input.Service_Discount_Percent / 100
    						visibility = false
    			)
			)
			Authorization_System_Generated_Values
			(
				type = section
				displayname = "Authorization & System Generated Values"
				visibility = true
	 			row = 9
	 			column = 0   
				width = medium
			)
			must have Service_Center_Guidelines_Display
			(
    			type = richtext
				displayname = "Service Center Guidelines Display"
				height = 200px
				toolbar = disable
    			description
    			[
    				type = help_text
    			 	message = "SERVICE CENTER GUIDELINES\n\n• Remove personal belongings before handing over your vehicle.\n\n• Estimates will be shared before any repair work begins.\n\n• Pickup/Drop service is available on request.\n\n• Please carry your insurance documents if applicable."
    			]
	 			row = 9
	 			column = 1   
				width = medium
			)
			QR_Code
			(
				type = qrcode
				displayname = "QR Code"
				value = "${Auto_Number}"
	 			row = 9
	 			column = 1   
				width = medium
			)
			must have Owner_Digital_Signature
			(
    			type = signature
				displayname = "Owner Digital Signature"
	 			row = 9
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Service_Request_Submitted_On
			(
    			type = datetime
				displayname = "Service Request Submitted On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 9
	 			column = 1   
				width = medium
			)
			Auto_Number
			(
    			type = autonumber
				displayname = "Auto Number"
				start index = 1
	 			row = 9
	 			column = 1   
				width = medium
			)
			Section
			(
				type = section
	 			row = 10
	 			column = 0   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Requested","In Repair","Ready for Pickup","Delivered"}
			}
		}
		form Vehicle_Models
		{
			displayname = "Vehicle Models"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Vehicle_Model
			(
    			type = text
				displayname = "Vehicle Model"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Standard_Service_Package
			(
    			type = text
				displayname = "Standard Service Package"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Estimated_Duration
			(
				type = number
				displayname = "Estimated Duration"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list Service_Request_Form_Report
		{
			displayName = "Service_Request_Form Report"
			show all rows from Service_Request_Form    
			(
				Owner_Name1  as "Owner Name"
				Pickup_Address  as "Pickup Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Email_Address as "Email Address"
				Contact_Number as "Contact Number"
				(
					displayformat = plainnumber 
				)
				Vehicle_Registration_Number as "Vehicle Registration Number"
				Issue_Description as "Issue Description"
				Odometer_Reading as "Odometer Reading"
				Preferred_Service_Date as "Preferred Service Date"
				Preferred_Dropoff_Time as "Preferred Dropoff Time"
				Vehicle_Type as "Vehicle Type"
				Service_Type as "Service Type"
				Additional_Services_Requested
				Authorize_Estimate_And_Repair as "Authorize Estimate And Repair"
				Requires_Pickup_Drop_Service as "Requires Pickup Drop Service"
				Service_Center_Guidelines_Display as "Service Center Guidelines Display"
				Insurance_Policy_Portal_URL as "Insurance Policy Portal URL"
				Vehicle_Damage_Photo as "Vehicle Damage Photo"
				Service_Discount_Percent as "Service Discount Percent"
				Estimated_Service_Cost as "Estimated Service Cost"
				Vehicle_Age_Years as "Vehicle Age  Years"
				Service_Request_Submitted_On as "Service Request Submitted On"
				Previous_Service_History.Previous_Service_Date as "Previous Service History"
				Vehicle_Models as "Vehicle Models"
				Owner_Digital_Signature as "Owner Digital Signature"
				Insurance_Copy_Upload as "Insurance Copy Upload"
				Engine_Sound_Voice_Note as "Engine Sound Voice Note"
				Vehicle_Issue_Video as "Vehicle Issue Video"
				Auto_Number as "Auto Number"
				Net_Service_Cost_Payable as "Net Service Cost Payable"
				QR_Code as "QR Code"
				Status
			)
		}
		default list Vehicle_Models_Report
		{
			displayName = "Vehicle Models Report"
			show all rows from Vehicle_Models    
			(
				Vehicle_Model as "Vehicle Model"
				Standard_Service_Package as "Standard Service Package"
				Estimated_Duration as "Estimated Duration"
			)
		}
		list All_Service_Requests_List
		{
			displayName = "All Service Requests List"
			show all rows from Service_Request_Form    
			(
				Owner_Name1  as "Owner Name"
				Vehicle_Registration_Number as "Vehicle Registration Number"
				Vehicle_Type as "Vehicle Type"
				Email_Address as "Email Address"
				Contact_Number as "Contact Number"
				(
					displayformat = plainnumber 
				)
				Pickup_Address  as "Pickup Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Odometer_Reading as "Odometer Reading"
				Service_Type as "Service Type"
				Additional_Services_Requested
				Issue_Description as "Issue Description"
				Preferred_Service_Date as "Preferred Service Date"
				Preferred_Dropoff_Time as "Preferred Dropoff Time"
				Authorize_Estimate_And_Repair as "Authorize Estimate And Repair"
				Vehicle_Models as "Vehicle Models"
				Vehicle_Damage_Photo as "Vehicle Damage Photo"
				Insurance_Copy_Upload as "Insurance Copy Upload"
				Vehicle_Age_Years as "Vehicle Age  Years"
				Insurance_Policy_Portal_URL as "Insurance Policy Portal URL"
				Vehicle_Issue_Video as "Vehicle Issue Video"
				Engine_Sound_Voice_Note as "Engine Sound Voice Note"
				Requires_Pickup_Drop_Service as "Requires Pickup Drop Service"
				Estimated_Service_Cost as "Estimated Service Cost"
				Service_Discount_Percent as "Service Discount Percent"
				Net_Service_Cost_Payable as "Net Service Cost Payable"
				Service_Center_Guidelines_Display as "Service Center Guidelines Display"
				QR_Code as "QR Code"
				Owner_Digital_Signature as "Owner Digital Signature"
				Service_Request_Submitted_On as "Service Request Submitted On"
				Auto_Number as "Auto Number"
			)
			sort by
			(
				Preferred_Service_Date ascending
			)
		}
		spreadsheet Service_Request_Spreadsheet
		{
			displayName = "Service Request Spreadsheet"
			show all rows from Service_Request_Form    
			(
				Owner_Name1  as "Owner Name"
				Vehicle_Registration_Number as "Vehicle Registration Number"
				Vehicle_Type as "Vehicle Type"
				Email_Address as "Email Address"
				Contact_Number as "Contact Number"
				(
					displayformat = plainnumber 
				)
				Pickup_Address  as "Pickup Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Odometer_Reading as "Odometer Reading"
				Service_Type as "Service Type"
				Additional_Services_Requested
				Issue_Description as "Issue Description"
				Preferred_Service_Date as "Preferred Service Date"
				Preferred_Dropoff_Time as "Preferred Dropoff Time"
				Authorize_Estimate_And_Repair as "Authorize Estimate And Repair"
				Vehicle_Models as "Vehicle Models"
				Vehicle_Damage_Photo as "Vehicle Damage Photo"
				Insurance_Copy_Upload as "Insurance Copy Upload"
				Vehicle_Age_Years as "Vehicle Age  Years"
				Insurance_Policy_Portal_URL as "Insurance Policy Portal URL"
				Vehicle_Issue_Video as "Vehicle Issue Video"
				Engine_Sound_Voice_Note as "Engine Sound Voice Note"
				Requires_Pickup_Drop_Service as "Requires Pickup Drop Service"
				Estimated_Service_Cost as "Estimated Service Cost"
				Service_Discount_Percent as "Service Discount Percent"
				Net_Service_Cost_Payable as "Net Service Cost Payable"
				Service_Center_Guidelines_Display as "Service Center Guidelines Display"
				QR_Code as "QR Code"
				Owner_Digital_Signature as "Owner Digital Signature"
				Service_Request_Submitted_On as "Service Request Submitted On"
				Auto_Number as "Auto Number"
			)
		}
		kanban Service_Status_Kanban
		{
			displayName = "Service Status Kanban"
			show all rows from Service_Request_Form    
			(
				Owner_Name1  as "Owner Name"
				Vehicle_Registration_Number as "Vehicle Registration Number"
				Vehicle_Type as "Vehicle Type"
				Email_Address as "Email Address"
				Contact_Number as "Contact Number"
				(
					displayformat = plainnumber 
				)
				Pickup_Address  as "Pickup Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Odometer_Reading as "Odometer Reading"
				Service_Type as "Service Type"
				Additional_Services_Requested
				Issue_Description as "Issue Description"
				Preferred_Service_Date as "Preferred Service Date"
				Preferred_Dropoff_Time as "Preferred Dropoff Time"
				Authorize_Estimate_And_Repair as "Authorize Estimate And Repair"
				Status
				Vehicle_Models as "Vehicle Models"
				Vehicle_Damage_Photo as "Vehicle Damage Photo"
				Insurance_Copy_Upload as "Insurance Copy Upload"
				Vehicle_Age_Years as "Vehicle Age  Years"
				Insurance_Policy_Portal_URL as "Insurance Policy Portal URL"
				Vehicle_Issue_Video as "Vehicle Issue Video"
				Engine_Sound_Voice_Note as "Engine Sound Voice Note"
				Requires_Pickup_Drop_Service as "Requires Pickup Drop Service"
				Estimated_Service_Cost as "Estimated Service Cost"
				Service_Discount_Percent as "Service Discount Percent"
				Net_Service_Cost_Payable as "Net Service Cost Payable"
				Service_Center_Guidelines_Display as "Service Center Guidelines Display"
				QR_Code as "QR Code"
				Owner_Digital_Signature as "Owner Digital Signature"
				Service_Request_Submitted_On as "Service Request Submitted On"
				Auto_Number as "Auto Number"
			)
			options
			(
	 			display field = Status
	 		)
		}
		calendar Service_Schedule_Calendar
		{
			displayName = "Service Schedule Calendar"
			show all rows from Service_Request_Form    
			(
				Vehicle_Damage_Photo as "Vehicle Damage Photo"
				Authorize_Estimate_And_Repair as "Authorize Estimate And Repair"
				Vehicle_Models as "Vehicle Models"
				Vehicle_Age_Years as "Vehicle Age  Years"
				Insurance_Policy_Portal_URL as "Insurance Policy Portal URL"
				Insurance_Copy_Upload as "Insurance Copy Upload"
				Odometer_Reading as "Odometer Reading"
				Service_Type as "Service Type"
				Pickup_Address  as "Pickup Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Email_Address as "Email Address"
				Contact_Number as "Contact Number"
				(
					displayformat = plainnumber 
				)
				Owner_Name1  as "Owner Name"
				Preferred_Service_Date as "Preferred Service Date"
				Preferred_Dropoff_Time as "Preferred Dropoff Time"
				Additional_Services_Requested
				Issue_Description as "Issue Description"
				Vehicle_Registration_Number as "Vehicle Registration Number"
				Vehicle_Type as "Vehicle Type"
				Status
				Added_Time as "Added Time"
				Modified_Time as "Modified Time"
				Estimated_Service_Cost as "Estimated Service Cost"
				Service_Discount_Percent as "Service Discount Percent"
				Net_Service_Cost_Payable as "Net Service Cost Payable"
				Vehicle_Issue_Video as "Vehicle Issue Video"
				Engine_Sound_Voice_Note as "Engine Sound Voice Note"
				Requires_Pickup_Drop_Service as "Requires Pickup Drop Service"
				Auto_Number as "Auto Number"
				Service_Center_Guidelines_Display as "Service Center Guidelines Display"
				QR_Code as "QR Code"
				Owner_Digital_Signature as "Owner Digital Signature"
				Service_Request_Submitted_On as "Service Request Submitted On"
			)
			options
			(
				display field = Preferred_Service_Date
				start date = Added_Time
				end date = Modified_Time
			)
		}
		map Map_View
		{
			displayName = "Map View"
